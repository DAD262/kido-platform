# Copia este archivo como .env SOLO para desarrollo local.
DB_USER=kido
DB_PASS=CAMBIAR_DB_PASSWORD_LOCAL

# Mercado Pago sandbox: usa un token TEST-... de tu cuenta de desarrollador.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_NOTIFICATION_URL=
KIDO_PAGOS_PERMITIR_SIMULACION=false
# Solo para evidencia S09; 0 desactiva el rechazo determinista.
KIDO_SAGA_ESTUDIANTE_FALLO_DEMO=0

# SMTP opcional. En DEV el correo se simula si SMTP_ENABLED=false.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=no-reply@kido.local

# Credenciales SOLO de desarrollo local. Cámbialas antes de compartir un ambiente.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_KEYCLOAK_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_GRAFANA_PASSWORD
