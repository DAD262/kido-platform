# Copia este archivo como .env SOLO para desarrollo local.
DB_USER=kido
DB_PASS=CAMBIAR_DB_PASSWORD_LOCAL
KIDO_CONFIG_PORT=18889

# Mercado Pago sandbox: usa un token TEST-... de tu cuenta de desarrollador.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_NOTIFICATION_URL=
# Página de retorno del frontend y redirección automática (true solo con URL pública https).
MERCADO_PAGO_RETURN_URL=http://localhost:4200/pago/resultado
MERCADO_PAGO_AUTO_RETURN=false
# Clave secreta de Webhooks (Tus integraciones → Webhooks → Configurar notificaciones).
MERCADO_PAGO_WEBHOOK_SECRET=
KIDO_PAGOS_PERMITIR_SIMULACION=false
# Solo para evidencia S09; 0 desactiva el rechazo determinista.
KIDO_SAGA_ESTUDIANTE_FALLO_DEMO=0

# SMTP opcional. En DEV el correo se simula si SMTP_ENABLED=false.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=no-reply@kido.local

# Credenciales SOLO de desarrollo local. Cámbialas antes de compartir un ambiente.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_KEYCLOAK_PASSWORD
# Debe coincidir exactamente con el claim iss de los JWT emitidos por Keycloak.
KEYCLOAK_ISSUER_URI=http://localhost:19090/realms/kido
# Secreto del cliente kido-usuario-admin: Keycloak lo importa del realm y kido-usuario-ms lo usa.
# Cámbialo fuera de tu PC; debe ser el mismo para ambos.
# Si lo cambias después de importar el realm, recrea Keycloak (ver GUIA_LEVANTAR_KIDO.md).
KIDO_USUARIO_ADMIN_SECRET=CAMBIAR_SECRETO_CLIENTE_USUARIOS
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_GRAFANA_PASSWORD

# Base persistente de identidad (conserva cuentas al recrear Keycloak).
KEYCLOAK_DB_PASSWORD=CAMBIAR_KEYCLOAK_DB_PASSWORD

# Recuperacion: por defecto SMTP local Mailpit, bandeja http://localhost:18025
KIDO_RECUPERACION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
RECUPERACION_SMTP_HOST=kido-mailpit
RECUPERACION_SMTP_PORT=1025
RECUPERACION_SMTP_USER=
RECUPERACION_SMTP_PASS=
RECUPERACION_SMTP_AUTH=false
RECUPERACION_SMTP_TLS=false
RECUPERACION_SMTP_FROM=no-reply@kido.local
KIDO_APP_URL=http://localhost:4200

# Elegir produccion solo al habilitar vendedor y URLs HTTPS reales.
MERCADO_PAGO_AMBIENTE=pruebas

# Confirmar con Mercado Pago que la cuenta admite recaudar y liquidar ventas de docentes.
MERCADO_PAGO_MODELO_RECAUDACION_CONFIRMADO=false
